{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@specter/core": ["packages/core/src/index.ts"],
      "@specter/core/*": ["packages/core/src/*"],
      "@specter/ai": ["packages/ai/src/index.ts"],
      "@specter/ai/*": ["packages/ai/src/*"],
      "@specter/ui": ["packages/ui/src/index.ts"],
      "@specter/ui/*": ["packages/ui/src/*"],
      "@specter/help": ["packages/help/src/index.ts"],
      "@specter/help/*": ["packages/help/src/*"]
    }
  }
}
