{
  "name": "@specter/extension",
  "description": "Specter — see what haunts your digital life.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@specter/ai": "workspace:*",
    "@specter/core": "workspace:*",
    "@specter/help": "workspace:*",
    "@specter/ui": "workspace:*",
    "clsx": "^2.1.1",
    "dexie": "^4.0.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^5.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
